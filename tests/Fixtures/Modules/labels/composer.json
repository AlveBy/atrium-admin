{
    "name": "acme/atrium-labels",
    "description": "Labels to put on things: a module package for the tests",
    "type": "atrium-module",
    "extra": {
        "atrium": {
            "resources": [
                "Atrium\\Admin\\Tests\\Fixtures\\Modules\\Label"
            ],
            "public_urls": {
                "Atrium\\Admin\\Tests\\Fixtures\\Modules\\Label": {
                    "prefix": "labels"
                }
            },
            "search": {
                "Atrium\\Admin\\Tests\\Fixtures\\Modules\\Label": {
                    "title": "name"
                }
            },
            "migrations": "database/migrations",
            "settings": "Atrium\\Admin\\Tests\\Fixtures\\Modules\\LabelSettings",
            "permissions": {
                "print": "Print labels",
                "posts.label": {
                    "label": "Label posts",
                    "with": "posts.update"
                }
            },
            "submodules": [
                "acme/atrium-labels-printing"
            ]
        }
    }
}
