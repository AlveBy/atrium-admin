<?php

declare(strict_types=1);

namespace {{ namespace }}\Models;

use Atrium\Admin\Cache\CachesRecords;
use Atrium\Admin\Columns\BooleanColumn;
use Atrium\Admin\Columns\TextColumn;
use Atrium\Admin\Contracts\Administrable;
use Atrium\Admin\Contracts\Cacheable;
use Atrium\Admin\Fields\CheckboxField;
use Atrium\Admin\Fields\ContentField;
use Atrium\Admin\Fields\NumberField;
use Atrium\Admin\Fields\TextField;
use Atrium\Admin\Traits\BelongsToSite;
use Atrium\Admin\Traits\InteractsWithAdmin;
use Atrium\Admin\Traits\Translatable;
use Illuminate\Database\Eloquent\Model;

/**
 * A record of the module: a name and a text in every content language, per
 * site. The fields and columns below are the admin's form and list. It is
 * Cacheable: public pages read it as a card (`{{ model }}::cached($id)`,
 * `->cachedPaginate()`), and a save drops what it touches. See docs/cache.md.
 */
class {{ model }} extends Model implements Administrable, Cacheable
{
    use BelongsToSite, CachesRecords, InteractsWithAdmin, Translatable;

    protected $table = '{{ table }}';

    /** @var array<int,string> */
    protected array $translatable = ['name', 'text'];

    protected $fillable = ['site_id', 'name', 'text', 'active', 'sort'];

    protected function casts(): array
    {
        return ['active' => 'boolean', 'sort' => 'integer'];
    }

    public static function getAdminLabel(): string
    {
        return __('{{ key }}::{{ key }}.label');
    }

    public static function getAdminCreateLabel(): string
    {
        return __('{{ key }}::{{ key }}.create');
    }

    public static function getAdminRoutePrefix(): string
    {
        return '{{ table }}';
    }

    public static function getDefaultSortColumn(): string
    {
        return 'sort';
    }

    public static function getDefaultSortDirection(): string
    {
        return 'asc';
    }

    public static function getAdministrationFields(): array
    {
        return [
            CheckboxField::make('active')->label(__('atrium::fields.standard.active'))->default(true),
            TextField::make('name')->label(__('{{ key }}::{{ key }}.fields.name'))->required(),
            ContentField::make('text')->label(__('{{ key }}::{{ key }}.fields.text')),
            NumberField::make('sort')->label(__('atrium::fields.standard.sort'))->default(500),
        ];
    }

    public static function getAdministrationListColumns(): array
    {
        return [
            TextColumn::make('id')->label(__('atrium::fields.standard.id'))->sortable(),
            TextColumn::make('name')->label(__('{{ key }}::{{ key }}.fields.name'))->sortable()->searchable(),
            TextColumn::make('sort')->label(__('atrium::fields.standard.sort'))->sortable(),
            BooleanColumn::make('active')->label(__('atrium::fields.standard.active')),
        ];
    }
}
